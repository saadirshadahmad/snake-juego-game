# SNAKEJUEGO Configuration
# Game embed URL (defaults to local responsive game embed)
NEXT_PUBLIC_SNAKE_GAME_EMBED_URL=/game/index.html

# Site domain and canonical base URL (configure your own domain when launching)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_DOMAIN=

# Verification Codes
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_ADSENSE_ACCOUNT=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_PINTEREST_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=
NEXT_PUBLIC_BAIDU_SITE_VERIFICATION=
NEXT_PUBLIC_NORTON_VERIFICATION=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Server-side Contact Email Settings
CONTACT_TO_EMAIL=contacto@example.com
CONTACT_FROM_EMAIL=notificaciones@example.com
EMAIL_PROVIDER_API_KEY=
